    position: absolute;
    box-sizing: content-box;
    pointer-events: auto;
    z-index: var(--os-components-importance-figure);

    &.o-figure-selected {
      z-index: var(--os-components-importance-figure-selected);
    }

    .o-fig-anchor {
      z-index: var(--os-components-importance-figure-anchor);
      position: absolute;
      width: 8px;
      height: 8px;
      background-color: var(--os-selection-border-color);
      outline: 1px solid white;

      &.o-top {
        cursor: n-resize;
      }
      &.o-topRight {
        cursor: ne-resize;
      }
      &.o-right {
        cursor: e-resize;
      }
      &.o-bottomRight {
        cursor: se-resize;
      }
      &.o-bottom {
        cursor: s-resize;
      }
      &.o-bottomLeft {
        cursor: sw-resize;
      }
      &.o-left {
        cursor: w-resize;
      }
      &.o-topLeft {
        cursor: nw-resize;
      }
